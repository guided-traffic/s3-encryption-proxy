# Where the demo compose stack (./start-demo.sh) is reachable from the host.
# Read by the client e2e up-scripts (bash) and by the harness package (Go), so a
# port or a credential cannot drift between the script that brings the stack up
# and the suite that talks to it. The values themselves come from
# docker-compose.demo.yml, config/aes-example.yaml and config/aes-tls-example.yaml.

# The proxy, both listeners. aws-sdk-go-v2 — and therefore rclone — emits
# STREAMING-UNSIGNED-PAYLOAD-TRAILER framing only over HTTPS, so only the TLS
# endpoint reaches the trailer decoder. s3cmd signs with the header form on both.
S3EP_HTTP_ENDPOINT=http://127.0.0.1:8080
S3EP_TLS_ENDPOINT=https://localhost:8443

# The first s3_clients entry of both demo configurations.
S3EP_ACCESS_KEY=username0
S3EP_SECRET_KEY=this-is-not-very-secure

# MinIO, addressed directly so the suite can read what is really stored.
S3EP_BACKEND_ENDPOINT=https://localhost:9000
S3EP_BACKEND_ACCESS_KEY=minioadmin
S3EP_BACKEND_SECRET_KEY=minioadmin123

S3EP_REGION=us-east-1

# The trust anchor for both TLS endpoints, generated by test/ssl-setup/gen-certs.sh
# and never committed. Relative to the repository root.
S3EP_CA_CERT=test/ssl-setup/ca.crt

# encryption.metadata_key_prefix and the stored format id (ADR 0003, ADR 0009).
# Spelled out rather than imported: these suites are black-box clients and both
# values are part of the stored format's contract, so a silent change must fail
# here.
S3EP_METADATA_PREFIX=s3ep-
S3EP_FORMAT_ID=s3ep-gcm-seg-v2

# optimizations.streaming_segment_size of both demo configurations: the ceiling
# above which a single-request PUT becomes the internal multipart producer.
S3EP_SEGMENT_SIZE=12582912
