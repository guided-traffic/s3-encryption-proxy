# Pinned version for the rclone e2e suite. Single file so Renovate has one place
# to update; see renovate.json customManagers, group "rclone e2e".
#
# Never "latest": this suite records what one named release of one named client
# makes of this proxy, and a claim that moves under its own feet is not evidence
# (ADR 0006 D7).
RCLONE_VERSION=v1.75.1
