# Pinned versions for the Velero e2e suite. Single file so Renovate has one
# place to update; see renovate.json customManagers, group "Velero e2e".
#
# Note: the Velero Helm chart lags the Velero release. Chart 12.1.0 ships
# appVersion 1.18.1, so VELERO_VERSION is applied as an explicit image.tag
# override. Without it the suite silently tests a different Velero than the one
# named here.

VELERO_VERSION=v1.18.2
VELERO_CHART_VERSION=12.1.0
VELERO_AWS_PLUGIN_VERSION=v1.14.2

# Cluster and storage stack. KIND_VERSION and KUBECTL_VERSION are only used by
# CI, which has neither preinstalled; locally the tools on PATH are used.
KIND_VERSION=v0.32.0
KUBECTL_VERSION=v1.36.2
KIND_NODE_IMAGE=kindest/node:v1.36.1
CSI_HOSTPATH_VERSION=v1.18.0
SNAPSHOTTER_VERSION=v8.6.0
CSI_ATTACHER_VERSION=v4.12.0
CSI_PROVISIONER_VERSION=v6.3.0
CSI_RESIZER_VERSION=v2.2.1
CSI_HEALTH_MONITOR_VERSION=v0.18.0
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z

# Cluster and object names the Go tests rely on
KIND_CLUSTER_NAME=s3ep-e2e
PROXY_NAMESPACE=s3ep
PROXY_RELEASE=s3ep
PROXY_IMAGE=guidedtraffic/s3-encryption-proxy:e2e
VELERO_NAMESPACE=velero
VELERO_BUCKET=velero
MINIO_NAMESPACE=minio

# Host-visible NodePorts (mapped by kind-config.yaml)
PROXY_NODEPORT=30443
MINIO_NODEPORT=30900

# Credentials Velero presents to the proxy. The proxy uses a different pair to
# reach MinIO on purpose: whoever holds the Velero secret must not thereby hold
# raw unencrypted backend access.
PROXY_CLIENT_ACCESS_KEY=velero-e2e
PROXY_CLIENT_SECRET_KEY=velero-secret-key-32-characters
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
