# Pinned version for the s3cmd e2e suite. Single file so Renovate has one place
# to update; see renovate.json customManagers, group "s3cmd e2e".
#
# Installed from PyPI rather than from the GitHub tarball: s3cmd is a Python
# program whose runtime dependency (python-dateutil) the tarball does not carry,
# and a version resolved by pip is the one reproducible way to pin both.
S3CMD_VERSION=2.4.0
